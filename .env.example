# Copy to .env and fill in as milestones need them. Week 1 needs none of these.
# All vars are prefixed CENTRALDOGMA_ (see api/config.py).

# Store backend: "demo" (default, no deps) or "pgvector" (Week 2+).
CENTRALDOGMA_STORE_BACKEND=demo

# Postgres + pgvector connection (Week 2+). Matches docker-compose.yml defaults.
# CENTRALDOGMA_DATABASE_URL=postgresql://centraldogma:centraldogma@localhost:5432/centraldogma

# Claude for figure reasoning and answer generation (Week 3+).
# CENTRALDOGMA_ANTHROPIC_API_KEY=sk-ant-...
# CENTRALDOGMA_GENERATION_MODEL=claude-sonnet-5
